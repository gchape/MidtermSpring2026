<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.provokedynamic.uno.db.mapper.GameMapper">

    <!--
        gameResultMap: one GameRecord row per game, with a nested collection
        of GamePlayerRecord rows.

        The outer <id> (g_id) lets MyBatis know when it has moved to a new game.
        The inner <id> (player_id) tells it when it has moved to a new player row
        within the same game — without it MyBatis cannot deduplicate correctly
        when multiple players share the same game_id.
    -->
    <resultMap id="gameResultMap" type="GameRecord">
        <id property="id" column="g_id"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="roundsPlayed" column="rounds_played"/>
        <collection property="players" ofType="GamePlayerRecord">
            <id property="playerId" column="player_id"/>
            <result property="playerName" column="player_name"/>
            <result property="score" column="score"/>
            <result property="winner" column="is_winner"/>
        </collection>
    </resultMap>

    <insert id="insertGame" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO games (started_at, finished_at, rounds_played)
        VALUES (#{startedAt}, #{finishedAt}, #{roundsPlayed})
    </insert>

    <update id="updateGame">
        UPDATE games
        SET finished_at = #{finishedAt},
        rounds_played = #{roundsPlayed}
        WHERE id = #{id}
    </update>

    <insert id="insertGamePlayer">
        INSERT INTO game_players (game_id, player_id, score, is_winner)
        VALUES (#{gameId}, #{playerId}, #{score}, #{winner})
    </insert>

    <!--
        findRecentGames: fetch the N most recently finished games together
        with all their player rows.  The sub-select limits the set of games;
        the outer joins hydrate the full resultMap.
    -->
    <select id="findRecentGames" resultMap="gameResultMap">
        SELECT g.id AS g_id,
        g.started_at,
        g.finished_at,
        g.rounds_played,
        gp.player_id,
        p.name AS player_name,
        gp.score,
        gp.is_winner
        FROM (
        SELECT id FROM games
        ORDER BY finished_at DESC
        LIMIT #{limit}
        ) AS recent
        JOIN games g ON g.id = recent.id
        JOIN game_players gp ON gp.game_id = g.id
        JOIN players p ON p.id = gp.player_id
        ORDER BY g.finished_at DESC, gp.is_winner DESC
    </select>

</mapper>